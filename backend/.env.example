# Copy to backend/.env. Never commit .env.
# Only these two are required:
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=

# ---- Everything below is optional; leave blank to use your Snowflake defaults ----
# SNOWFLAKE_ROLE=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=

# Account defaults to sfsehol-anthropic_snowflake_hackathon_fevwgp
# SNOWFLAKE_ACCOUNT=

# Auth defaults to "pat" (the token above). Other options:
#   password        -> SNOWFLAKE_PASSWORD
#   keypair         -> SNOWFLAKE_PRIVATE_KEY_PATH (+ SNOWFLAKE_PRIVATE_KEY_PASSPHRASE)
#   externalbrowser -> SSO in a browser, local only
# SNOWFLAKE_AUTH=pat

# CORS_ORIGINS=http://localhost:5173
