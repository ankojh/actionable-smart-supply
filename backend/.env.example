# Copy to backend/.env and fill in. Never commit .env.

# Account identifier: <org>-<account>, as in app.snowflake.com/<org>/<account>
SNOWFLAKE_ACCOUNT=sfsehol-anthropic_snowflake_hackathon_fevwgp
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Auth: one of "password", "keypair", "externalbrowser" (SSO, local only), "pat"
SNOWFLAKE_AUTH=password

# password auth
SNOWFLAKE_PASSWORD=

# keypair auth: path to an unencrypted or encrypted PKCS#8 .p8 key
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# pat auth: programmatic access token
SNOWFLAKE_TOKEN=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
