# Optional for the explicitly labeled offline demo. Never commit real secrets.
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=
SNOWFLAKE_ACCOUNT=sfsehol-anthropic_snowflake_hackathon_fevwgp
SNOWFLAKE_AUTH=pat
# Explicit REST route: session uses the configured SQL login; pat uses SNOWFLAKE_TOKEN.
SNOWFLAKE_REST_AUTH=session
# Setup context; runtime always uses the dedicated app role below.
SNOWFLAKE_ROLE=ATTENDEE_ROLE
SNOWFLAKE_DATABASE=DEFAULT_DATABASE
SNOWFLAKE_WAREHOUSE=DEFAULT_WH
SNOWFLAKE_APP_SCHEMA=SUPPLY_RECOVERY_V1
SNOWFLAKE_APP_ROLE=PROJECT_RECOVERY_APP_V1
SNOWFLAKE_CORTEX_MODEL=claude-sonnet-4-6
# Native managed specialist objects must be provisioned before a live assessment.
SNOWFLAKE_USE_CORTEX_AGENTS=true
SNOWFLAKE_MAX_COMPLETION_TOKENS=512
SNOWFLAKE_SEARCH_SERVICE=EVIDENCE_SEARCH
SNOWFLAKE_SEMANTIC_VIEW=RECOVERY_ANALYTICS
# Optional Snowsight organization/account URL; required when ACCOUNT uses a locator.
# SNOWFLAKE_SNOWSIGHT_URL=https://app.snowflake.com/your-org/your-account
# Use a PAT bound to the app role for REST, or an unrestricted approved PAT
# with the app role permitted; REST explicitly sends the app role header. No provider fallback.
# SNOWFLAKE_REST_BASE_URL=https://YOUR_ACCOUNT.snowflakecomputing.com
# A separately authorized evaluator identity/PAT is required for evaluator export.
# SNOWFLAKE_EVALUATOR_USER=
# SNOWFLAKE_EVALUATOR_TOKEN=
# SNOWFLAKE_EVALUATOR_ROLE=PROJECT_RECOVERY_EVALUATOR_V1
# Local host authorized manager; required for live human decisions.
# PROJECT_LIVE_REVIEWER_ID=
# PROJECT_LIVE_REVIEWER_TOKEN=
# PROJECT_STORE=/absolute/path/to/project.sqlite3
# CORS_ORIGINS=http://localhost:5173
# Other auth options: password, keypair, externalbrowser (SQL only).
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Active NorthStar workspace: real SQL and hosted Claude, no local fallback.
PROJECT_NORTHSTAR_MODE=live
# Provision the NorthStar V2 coordinator and both specialist Agents before use.
# Explicit ai_complete preserves the original implementation; no automatic fallback.
PROJECT_NORTHSTAR_AI_PROVIDER=cortex_agent
PROJECT_NORTHSTAR_MAX_COMPLETION_TOKENS=1200
